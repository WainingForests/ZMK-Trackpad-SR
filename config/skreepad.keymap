#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q                         &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  
&kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q                         &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  
&kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q                  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  
&kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q                         &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  
&kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q                         &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  
              &kp Q  &kp Q                                                                   &kp Q  &kp Q
                            &kp Q  &kp Q  &kp Q                         &kp Q  &kp Q  &kp Q
                            &kp Q  &kp Q  &kp Q                         &kp Q  &kp Q  &kp Q
            >;

            sensor-bindings = <&inc_dec_kp LEFT RIGHT>, <&inc_dec_kp UP DOWN>, <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        function_layer {
            bindings = <
&kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q                         &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  
&kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q                         &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  
&kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q                  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  
&kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q                         &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  
&kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q                         &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  
              &kp Q  &kp Q                                                                   &kp Q  &kp Q
                            &kp Q  &kp Q  &kp Q                         &kp Q  &kp Q  &kp Q
                            &kp Q  &kp Q  &kp Q                         &kp Q  &kp Q  &kp Q
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>, <&inc_dec_kp HOME END>, <&inc_dec_kp C_BRI_UP C_BRI_DN>;
        };

        bluetooth_layer {
            bindings = <
&kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q                         &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  
&kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q                         &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  
&kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q                  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  
&kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q                         &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  
&kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q                         &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  &kp Q  
              &kp Q  &kp Q                                                                   &kp Q  &kp Q
                            &kp Q  &kp Q  &kp Q                         &kp Q  &kp Q  &kp Q
                            &kp Q  &kp Q  &kp Q                         &kp Q  &kp Q  &kp Q
            >;

            sensor-bindings = <&inc_dec_kp C_PREV C_NEXT>, <&inc_dec_kp C_RW C_FF>, <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
